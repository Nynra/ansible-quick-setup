# This file is installed for Bash by this role. Avoid changing non-interactive
# shells that happen to source it.
case $- in
    *i*) ;;
    *) return ;;
esac

export GOPATH="${GOPATH:-$HOME/go}"
# Debian-family distributions may install Go in /usr/lib/go.
if [ -d /usr/lib/go ]; then
    export GOROOT="${GOROOT:-/usr/lib/go}"
fi

# Add common executable directories only when they exist and are not duplicated.
for path_entry in /usr/local/bin /usr/bin /bin /usr/local/sbin /usr/sbin /sbin "{{ target_user_home }}/.local/bin"; do
    if [ -d "$path_entry" ] && [[ ":$PATH:" != *":$path_entry:"* ]]; then
        PATH="$PATH:$path_entry"
    fi
done
export PATH

if [ -z "${EDITOR:-}" ]; then
    # Prefer Vim, but keep the environment usable on minimal installations.
    if command -v vim >/dev/null 2>&1; then
        EDITOR="$(command -v vim)"
    elif command -v vi >/dev/null 2>&1; then
        EDITOR="$(command -v vi)"
    fi
fi
export EDITOR
export TERM="${TERM:-xterm-256color}"
unset MAILCHECK

export TMUX_PLUGIN_MANAGER_PATH="{{ tmux_plugins_manager_path }}"

# Only use colored prompts when the shell has a terminal and tput supports colors.
if [ -t 1 ] && command -v tput >/dev/null 2>&1 && tput setaf 1 >/dev/null 2>&1; then
    color_prompt=yes
else
    color_prompt=
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt

if command -v dircolors >/dev/null 2>&1; then
    eval "$(dircolors -b)"
    alias ls='ls --color=auto'
fi

## Append to history file; do not overwrite
shopt -s histappend

## Where to search for manual pages
# Keep a user-provided MANPATH intact; otherwise use standard Debian paths.
if [ -z "${MANPATH:-}" ]; then
    export MANPATH="/usr/local/man:/usr/share/man"
fi

## grep aliases
if command -v grep >/dev/null 2>&1; then
    alias grep="grep --color=auto"
fi

## List open ports
# ss is provided by iproute2 and is more commonly installed than netstat.
if command -v ss >/dev/null 2>&1; then
    alias ports="ss -tulnp"
elif command -v netstat >/dev/null 2>&1; then
    alias ports="netstat -tulnp"
fi

## Extract file, example. "ex package.tar.bz2"
# Extract common archive formats without failing the shell when no file is given.
ex() {
    if [[ $# -ne 1 || ! -f $1 ]]; then
        printf '%s\n' "${1:-No archive specified} is not a valid file" >&2
        return 1
    fi
    case $1 in
        *.tar.bz2|*.tbz2) tar xjf "$1" ;;
        *.tar.gz|*.tgz)   tar xzf "$1" ;;
        *.bz2)            bunzip2 "$1" ;;
        *.rar)            rar x "$1" ;;
        *.gz)             gunzip "$1" ;;
        *.tar)            tar xf "$1" ;;
        *.zip)            unzip "$1" ;;
        *.Z)              uncompress "$1" ;;
        *.7z)             7z x "$1" ;;
        *)                printf '%s\n' "$1 cannot be extracted" >&2; return 1 ;;
    esac
}

## SSH autocompletion
# Completion is optional because minimal Bash installations may not load it.
if declare -F complete >/dev/null 2>&1; then
    _ssh_autocomplete() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    # Combine hosts from config and known_hosts
    opts=$(grep '^Host' "{{ target_user_home }}/.ssh/config" "{{ target_user_home }}"/.ssh/config.d/* 2>/dev/null | grep -v '[?*]' | cut -d ' ' -f 2-)
    # Add known_hosts entries if not hashed
    if [ -f "{{ target_user_home }}/.ssh/known_hosts" ]; then
        known=$(cut -f 1 -d ' ' "{{ target_user_home }}/.ssh/known_hosts" | sed -e s/,.*//g | grep -v '^\[')
        opts="$opts $known"
    fi
    COMPREPLY=( $(compgen -W "$opts" -- ${cur}) )
    return 0
    }
    complete -F _ssh_autocomplete ssh scp sftp 2>/dev/null
fi

if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
	function command_not_found_handle {
	    # check because c-n-f could've been removed in the meantime
        if [ -x /usr/lib/command-not-found ]; then
		    /usr/lib/command-not-found -- "$1"
            return $?
        elif [ -x /usr/share/command-not-found/command-not-found ]; then
		    /usr/share/command-not-found/command-not-found -- "$1"
            return $?
		else
		    printf "%s: command not found\n" "$1" >&2
		    return 127
		fi
	}
fi
