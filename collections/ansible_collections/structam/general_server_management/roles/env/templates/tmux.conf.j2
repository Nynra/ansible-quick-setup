# Core Settings
set -g mouse on
set -g history-limit 50000
set -g display-time 4000
set -g status-interval 5

# Improve colors
#set -g default-terminal "screen-256color"
set -g default-terminal "xterm-color"
set-option -a terminal-features "xterm-color:RGB"

# Remap prefix from 'C-b' to 'C-a' (easier to reach)
unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# Unbind clear from C to prevent accidental clears and set to O
unbind C
bind O clear-history

# Easy refreshing of tmux config (r)
unbind r
bind r source-file ~/.tmux.conf

# Set move window left/right to < and >
bind-key -r "<" swap-window -d -t -1
bind-key -r ">" swap-window -d -t +1

# Start windows and panes index at 1, not 0.
set -g base-index 1
setw -g pane-base-index 1

# Ensure window index numbers get reordered on delete.
set-option -g renumber-windows on

# Quality of Life (use | and - for splitting)
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %

# Easy pane resizing
bind -r j resize-pane -D 5
bind -r k resize-pane -U 5
bind -r l resize-pane -R 5
bind -r h resize-pane -L 5

# Maximizing and minimizing tmux pane (m)
bind -r m resize-pane -Z

# Configure vim movements for tmux copy mode
set-window-option -g mode-keys vi

bind-key -T copy-mode-vi 'v' send -X begin-selection # start selecting text with "v"
bind-key -T copy-mode-vi 'y' send -X copy-selection # copy text with "y"

unbind -T copy-mode-vi MouseDragEnd1Pane # don't exit copy mode after dragging with mouse

# Status Bar Styling
set -g status-bg black
set -g status-fg green
set -g status-left-length 20
set -g status-left '#[fg=cyan][#S] '
set -g status-right '#[fg=yellow]%Y-%m-%d #[fg=white]%H:%M:%S'

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-logging'
set -g @plugin 'christoomey/vim-tmux-navigator' # for navigating panes and vim/nvim with Ctrl-hjkl

# some other nice plugins
# https://github.com/tmux-plugins/tmux-resurrect
# https://github.com/tmux-plugins/tmux-pain-control
# https://github.com/tmux-plugins/tmux-sessionist

# Initialize TMUX plugin manager (keep at bottom)
run-shell "{{ tmux_plugins_manager_path }}/tpm/tpm"
